# =============================================================================
# bdelko configuration
#
# Copy this file to ".env" and adjust. Every variable is optional except where
# marked Required; startup fails fast with a readable list when something
# required is missing or invalid.
#
# The "Public URL" block below must describe the address where YOU reach
# bdelko in a browser. It is used to build the heartbeat URLs shown in the UI
# and API. Four typical deployments - pick one and set the block accordingly:
#
#   1) Local use on this machine (http://localhost:3001):
#        BDELKO_SECURE=false
#        BDELKO_SUBDOMAIN=
#        BDELKO_DOMAIN=localhost
#        BDELKO_PUBLIC_PORT=3001
#        BDELKO_BASE_PATH=
#        BDELKO_TRUST_PROXY=
#
#   2) Behind nginx at a domain root (https://example.org):
#        BDELKO_SECURE=true
#        BDELKO_SUBDOMAIN=
#        BDELKO_DOMAIN=example.org
#        BDELKO_PUBLIC_PORT=
#        BDELKO_BASE_PATH=
#        BDELKO_TRUST_PROXY=true
#
#   3) Behind nginx under a base path (https://example.org/bdelko):
#        BDELKO_SECURE=true
#        BDELKO_SUBDOMAIN=
#        BDELKO_DOMAIN=example.org
#        BDELKO_PUBLIC_PORT=
#        BDELKO_BASE_PATH=bdelko
#        BDELKO_TRUST_PROXY=true
#
#   4) Behind nginx on a subdomain (https://bdelko.example.org):
#        BDELKO_SECURE=true
#        BDELKO_SUBDOMAIN=bdelko
#        BDELKO_DOMAIN=example.org
#        BDELKO_PUBLIC_PORT=
#        BDELKO_BASE_PATH=
#        BDELKO_TRUST_PROXY=true
#
# (nginx configs for scenarios 2-4 are in the README; scenario 1 below is the
# active default.)
# =============================================================================

# --- Server ---
BDELKO_HOST=127.0.0.1              # bind address (keep 127.0.0.1 behind nginx)
BDELKO_PORT=3001                   # local listening port  # Required
BDELKO_TRUST_PROXY=                # "true" behind nginx (needed for rate limiting per real client IP)

# --- Public URL (see deployment scenarios at the top of this file) ---
BDELKO_SECURE=false                # true -> https://, false -> http://
BDELKO_SUBDOMAIN=                  # e.g. "bdelko" -> https://bdelko.example.org ; empty = none
BDELKO_DOMAIN=localhost            # Required
BDELKO_PUBLIC_PORT=3001            # port in public URL; empty = omit (80/443 behind proxy)
BDELKO_BASE_PATH=                  # e.g. "bdelko" -> https://example.org/bdelko ; no slashes

# --- Auth ---
BDELKO_API_TOKEN=                  # long random string; sent as "Authorization: Bearer <token>"  # Required

# --- Rate limiting (per client IP, applies to the whole API incl. heartbeat) ---
BDELKO_RATE_LIMIT_MAX=300          # requests allowed per window; 0 = disabled
BDELKO_RATE_LIMIT_WINDOW_MS=60000  # window length; over the limit -> 429 + Retry-After

# --- Monitoring ---
# (the scan interval is hardcoded to 60000 ms - not configurable)
BDELKO_REQUEST_TIMEOUT_MS=30000    # HTTP timeout for active checks (default interval/2)
BDELKO_GAP_MARGIN_MS=15000         # tolerance before a missed run counts as a gap
BDELKO_CONNECTIVITY_CHECK=true     # DNS check before each run; skip run if offline
BDELKO_DEFAULT_THRESHOLD_MINUTES=3
BDELKO_MIN_WD_NAME_LENGTH=1
BDELKO_MAX_WD_NAME_LENGTH=40
BDELKO_MAX_WD_URL_LENGTH=2000
BDELKO_USER_AGENT=bdelko-monitor/1.0

# --- Web UI ---
BDELKO_SERVE_UI=true               # serve the built UI from this server
BDELKO_UI_DIST_PATH=./ui/dist      # folder containing the built UI

# --- Storage & logging ---
BDELKO_DB_PATH=./data/bdelko.db
BDELKO_LOG_DIR=./logs
BDELKO_LOG_LEVEL=info              # winston level
BDELKO_LOG_MAX_SIZE_MB=10          # size-based rotation of system log
BDELKO_LOG_MAX_FILES=5
BDELKO_CONSOLE_RUNS=true           # colored per-run console output (like JASMA)

# --- Email (nodemailer). If BDELKO_MAIL_HOST is empty, mailing is disabled with a startup warning ---
BDELKO_NOTIFY_EMAIL=               # single recipient for all notifications
BDELKO_MAIL_HOST=
BDELKO_MAIL_PORT=
BDELKO_MAIL_SECURE=
BDELKO_MAIL_USER=
BDELKO_MAIL_PASS=
BDELKO_MAIL_FROM_ADDRESS=
BDELKO_MAIL_FROM_NAME=bdelko
BDELKO_MAIL_TLS_REJECT_UNAUTHORIZED=
BDELKO_MAIL_DKIM_DOMAIN=
BDELKO_MAIL_DKIM_SELECTOR=
BDELKO_MAIL_DKIM_PRIVKEY=
